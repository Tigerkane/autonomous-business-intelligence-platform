# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Pluggable AI / LLM Configuration
# LLM_PROVIDER: "deterministic" | "ollama" | "ollama_cloud"
LLM_PROVIDER="deterministic"
# Local Ollama daemon endpoint (default http://localhost:11434)
LLM_BASE_URL="http://localhost:11434"
# LLM model identifier (e.g. llama3.2, gpt-oss:120b)
LLM_MODEL="llama3.2"
# Optional API Key for hosted providers (Ollama Cloud or OpenAI compatible)
LLM_API_KEY=""
OLLAMA_API_KEY=""
